{
	"name": "point-monorepo",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build --filter=@point/main...",
		"dev": "turbo dev --filter=@point/main...",
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --fix",
		"check:unused": "knip --max-issues 1",
		"check:unused:fix": "knip --fix",
		"typecheck": "pnpm -r typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@point/tailwind-config": "workspace:*",
		"@point/typescript-config": "workspace:*",
		"@types/node": "^22.5.2",
		"knip": "^5.56.0",
		"lefthook": "1.11.13",
		"turbo": "^2.5.3",
		"typescript": "5.8.3"
	},
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"node": ">=22.11.0",
		"pnpm": ">=10.2.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild",
			"lefthook",
			"msw"
		]
	}
}
