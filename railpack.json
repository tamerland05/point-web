{
  "$schema": "https://schema.railpack.com",
  "caches": {
    "node-modules": {
      "directory": "/app/node_modules/.cache",
      "type": "shared"
    },
    "turbo-repo": {
      "directory": "/app/.turbo/cache",
      "type": "shared"
    }
  },
  "install": {
    "secrets": ["*"]
  },
  "build": {
    "caches": ["node-modules", "turbo-repo"],
    "secrets": ["*"]
  },
  "deploy": {
    "secrets": ["*"]
  },
  "secrets": ["*"]
}
