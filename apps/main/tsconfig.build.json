{
  "extends": "@point/typescript-config/react.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/atoms/user": ["src/atoms/user", "../../packages/shared/src/atoms/user"],
      "@/*": ["src/*", "../../packages/shared/src/*"],
      "@point/shared/*": ["../../packages/shared/dist/*", "../../packages/shared/src/*"],
      "@point/ui/*": ["../../packages/ui/src/*"]
    },
    "skipLibCheck": true
  },

  "include": ["src"]
}
