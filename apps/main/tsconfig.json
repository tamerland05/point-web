{
  "extends": "@point/typescript-config/react.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    // Custom settings
    "baseUrl": ".",
    "paths": {
      "@/atoms/user": ["../../packages/shared/src/atoms/user", "src/atoms/user"],
      "@/*": ["src/*", "../../packages/shared/src/*"],
      "@point/shared/*": ["../../packages/shared/src/*"],
      "@point/ui/*": ["../../packages/ui/src/*"]
    },
    "skipLibCheck": true
  },
  "include": ["src"]
}
