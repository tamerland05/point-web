{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build-storybook": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md", "!eslint.config.js", "!tsconfig.build.json"],
      "outputs": ["storybook-static/**"]
    },
    "storybook": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    }
  }
}
